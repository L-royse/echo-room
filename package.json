{
  "name": "echo-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node --check server/index.mjs && node --check server/app.mjs && node --check server/media.mjs && node --check web/app.js",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mediasoup": "^3.19.0",
    "mediasoup-client": "^3.18.0",
    "ws": "^8.18.0"
  },
  "devDependencies": { "esbuild": "^0.25.0" }
}

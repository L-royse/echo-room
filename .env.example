# 本地可直接使用；生产必须替换下面四项。
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
RTC_ANNOUNCED_ADDRESS=127.0.0.1
RTC_LISTEN_IP=0.0.0.0
RTC_PORT=40000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
INVITE_CODE=replace-with-a-private-invite-code
MAX_VOICE_USERS=8
MAX_ROOM_USERS=8
MAX_CONNECTIONS=40
MAX_USERS=100
DATA_DIR=./data
# 可选：配置你自己的 TURN（支持逗号分隔多个 URL），不要填写公共匿名中继。
TURN_URLS=
TURN_SECRET=
TURN_REALM=echo-room
